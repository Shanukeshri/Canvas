# Database (PostgreSQL / Supabase / Neon)
DATABASE_URL="postgresql://postgres:password@host:5432/postgres"

# NextAuth / Auth.js Secret
AUTH_SECRET="canvas-productivity-secret-key-development-32-chars-long!"
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth Credentials (obtain from Google Cloud Console)
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="GOCSPX-your-google-client-secret"

# Realtime / Socket.IO URL
NEXT_PUBLIC_SOCKET_URL="http://localhost:3000"

# Redis (Upstash / ioredis for distributed realtime / presence in production)
REDIS_URL="redis://default:password@your-redis-host:6379"

# Vercel Blob (for storing custom audio assets)
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# Node Environment
NODE_ENV="development"
